# Copy this to .env and adjust for your machine. docker-compose.yml reads
# these via ${VAR} substitution — nothing here should be hardcoded in
# docker-compose.yml or in backend code, since every one of these is
# something that's genuinely expected to change: the SD backend could stop
# being ComfyUI, a portable ComfyUI install can move to a different path,
# and ports/host can differ per machine. See the root AGENTS.md's CTE
# section for the full rationale (same "swappable, not hardcoded"
# principle already applied to the chat/embedding AI providers).

# The machine's address as seen from a browser. "localhost" is correct for
# running everything on one machine; change this if the frontend is ever
# opened from a different device on the LAN.
HOST=localhost

# Host-side ports docker-compose publishes each service on. Changing these
# also changes the browser-facing URLs composed below — no separate value
# to keep in sync.
BACKEND_PORT=8000
FRONTEND_PORT=3000
OWNER_AGENT_PORT=8100

# Signs/verifies the JWTs backend and owner-agent both issue/check — shared
# between the two services (see docker-compose.yml). The default below is
# fine for a local demo that never leaves the host; change it before ever
# exposing either service beyond localhost.
JWT_SECRET=dev-only-insecure-secret-change-me

# ComfyUI (or whatever image-gen backend eventually replaces it — see the
# root AGENTS.md's provider-swap principle, extended here to image
# generation). COMFYUI_HOST is resolved *from inside the backend
# container*, so "host.docker.internal" (Docker's alias for the host
# machine) is correct when ComfyUI runs on the same machine as Docker
# Desktop, same as Ollama's setup.
COMFYUI_HOST=host.docker.internal
COMFYUI_PORT=8188

# Host-machine path to ComfyUI's own --output-directory (bind-mounted into
# the backend container at /comfy_output — see docker-compose.yml). A
# portable ComfyUI install can be moved anywhere; update only this value,
# nothing else needs to change. Windows path, no trailing slash.
COMFYUI_HOST_OUTPUT_DIR=D:\AI_Models\comfy\output

# NOT consumed by docker-compose.yml or any service here — unlike every
# variable above, this one exists purely for YOUR OWN convenience when
# scripting a self-hosted inference server's startup command (llama.cpp's
# llama-server, vLLM, ...). See models/README.md for the full "how to run
# your own local model and point this app at it" walkthrough — you still
# connect it via the dashboard's Model settings "Custom endpoint" block,
# not this variable.
LOCAL_MODELS_DIR=./models
