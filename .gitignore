# machine-specific config — see .env.example for the template
/.env

# Claude Code local settings (personal, not shared)
/.claude/

# Python
__pycache__/
*.pyc

# runtime data — uploaded RAG documents / CTE media uploads / public chat
# attachments (backend/apis/documents.py, backend/apis/media.py, backend/apis/chat.py)
/backend/storage/

# runtime data — owner-agent's action log (owner-agent/logging_.py)
/owner-agent/logs/

# runtime data — backend's unhandled-error log (backend/error_alerts.py)
/backend/logs/

# runtime data — locally downloaded LLM model files, see models/README.md.
# Model files are large and machine-specific; this repo only tracks the
# folder's own README + .gitkeep, never what an owner drops into it.
/models/*
!/models/.gitkeep
!/models/README.md

# editor scratch space
/.scratch/

# stray Windows artifact, not real project content
/backend/nul

# personal interview-prep notes, not project content
/interview-talking-points.md

# local test/reference material (RAG test PDFs, template screenshots), not
# project content
/materials/

# local demo video source file, not project content — the README links a
# GitHub-hosted copy instead
/Video Project (10mb).mp4
